generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
}

model Product {
  id         Int      @id @default(autoincrement())
  category   String
  icon       String
  // No longer editable from the admin panel — every product now ships with
  // real photos, so the tinted icon-tile fallback this drove is effectively
  // retired. Kept (defaulted) rather than dropped, since it's still read as
  // a fallback if a product somehow ends up with zero images.
  tint       String   @default("teal")
  price      Int
  // Percentage off `price` (0-100). Null/0 means no discount.
  discountPercent Int?
  isNew      Boolean  @default(false)
  // Featured in the homepage Hero carousel when true.
  showInHero Boolean  @default(false)
  // { ar: string, en: string } — kept as JSON to mirror the app's LocalizedText shape.
  name       Json
  tag        Json
  desc       Json
  // string[] of R2 URLs — first entry is the cover photo shown in listings.
  images     Json    @default("[]")
}

model Category {
  key String @id
  ar  String
  en  String
}

model Order {
  id               Int      @id @default(autoincrement())
  customerName     String
  phone            String
  address          String
  city             String
  paymentMethod    String
  paymentReference String?
  // R2 URL of the uploaded InstaPay/Vodafone Cash transfer screenshot.
  paymentProofUrl  String?
  // OrderItem[] — { productId, name, price, qty }
  items            Json
  subtotal         Int
  notes            String?
  status           String
  createdAt        DateTime @default(now())
}

model CustomOrder {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  category     String
  description  String
  imagePath    String?
  status       String
  internalNote String?  @default("")
  createdAt    DateTime @default(now())
}

model Settings {
  id                 Int    @id @default(1)
  instapayHandle     String
  vodafoneCashNumber String
  // Used as the order-confirmation "contact us" number, and shown on the
  // Contact page and in the footer.
  whatsappNumber     String @default("")
  contactEmail       String @default("")
  socialInstagram    String @default("")
  socialTiktok       String @default("")
  // R2 URL for the photo shown in the About page's image slot. Empty means
  // no photo has been uploaded yet — the page falls back to a decorative
  // illustration in that case.
  aboutImageUrl      String @default("")
}
