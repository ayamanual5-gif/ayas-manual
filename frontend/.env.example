# --- Local development ---
# Base URL of the backend API, called directly from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Production (Vercel) ---
# Leave NEXT_PUBLIC_API_BASE_URL EMPTY in production. The frontend then calls
# relative /api/... paths, which next.config.ts proxies server-side to BACKEND_URL —
# so the browser only ever sees one domain (no CORS, no cross-site cookies).
#
#   NEXT_PUBLIC_API_BASE_URL=
#   BACKEND_URL=https://your-backend-project.vercel.app
