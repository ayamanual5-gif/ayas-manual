# Port the Express server listens on
PORT=4000

# Origin allowed to call this API (the frontend's local dev URL)
CORS_ORIGIN=http://localhost:3000

# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# Use a pooled/"transaction mode" connection string if your provider offers one —
# required for serverless deployments (e.g. Vercel) to avoid exhausting connections.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin account (single admin, no user table) ---
# Email used to log into /admin
ADMIN_EMAIL=admin@ayasmanual.com

# Bcrypt hash of the admin password — never store the plain password here.
# Generate one with:  npm run hash-password -- "YourStrongPassword"
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin JWT cookie — use a long random string in real use.
JWT_SECRET=change-this-to-a-long-random-string
